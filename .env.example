# Copy to .env in the repository root. Never commit .env or real credentials.
APP_ENV=development
LOG_LEVEL=INFO

# Local PostgreSQL with the pgvector extension enabled.
DATABASE_URL=postgresql+psycopg://decision_intelligence:change_me@localhost:5432/decision_intelligence

# Public repositories can be read without a token. Set one to raise API rate limits.
GITHUB_TOKEN=
GITHUB_API_BASE_URL=https://api.github.com

# Local inference configuration. The embedding model is independent of the chat model.
OLLAMA_BASE_URL=http://localhost:11434
GEMMA_MODEL=gemma3:4b
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# Production only. Serve the built frontend from the backend, and load models at startup.
FRONTEND_DIST=
WARM_UP_MODELS=false

# Set on a public server so only you can import, sync and extract. Empty means open.
ADMIN_API_KEY=
# Searches and questions allowed per visitor IP each minute. 0 turns the limit off.
QUESTIONS_PER_MINUTE=10
# The same for each signed-in user, counted by account.
SIGNED_IN_QUESTIONS_PER_MINUTE=30
# Encrypts users' GitHub tokens. Sign-in is off when empty. Generate one with:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=
# The SilS GitHub App's client ID and secret, for signing in with GitHub.
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
# Where browsers reach this API, and where people land after signing in.
# In production both are the site's address, e.g. https://sils.example.com
PUBLIC_URL=http://localhost:8000
APP_URL=http://localhost:5173
