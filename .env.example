# Copy to .env in the repository root. Never commit .env or real credentials.
APP_ENV=development
LOG_LEVEL=INFO

# Local PostgreSQL with the pgvector extension enabled.
DATABASE_URL=postgresql+psycopg://decision_intelligence:change_me@localhost:5432/decision_intelligence

# Public repositories can be read without a token. Set one to raise API rate limits.
GITHUB_TOKEN=
GITHUB_API_BASE_URL=https://api.github.com

# Local inference configuration. The embedding model is independent of the chat model.
OLLAMA_BASE_URL=http://localhost:11434
GEMMA_MODEL=gemma3:4b
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
